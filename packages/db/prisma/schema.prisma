generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id            String    @id @default(cuid())
  name          String
  phone         String?
  address       String?
  mapsUrl       String?
  /// Plain-language nurse hours shown to patients, e.g. "9 الصبح لـ 5 العصر"
  nurseHours    String?
  /// Typical reply time in hours, shown in the auto-reply
  replyHours    Int       @default(2)
  erHospital    String?
  erMapsUrl     String?
  /// Clinic-authored, doctor-signed instructions. Never generated by the app.
  missedPillOne String?
  missedPillTwo String?
  fastingAdvice String?
  users         User[]
  patients      Patient[]
  prescriptions Prescription[]
  createdAt     DateTime  @default(now())
}

enum Role {
  DOCTOR
  NURSE
  RECEPTION
  PATIENT
}

model User {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  role      Role
  name      String
  phone     String   @unique
  patient   Patient?
  createdAt DateTime @default(now())

  // Staff sign-in: password + authenticator app (TOTP). Patients never use these.
  passwordHash   String?
  totpSecret     String?   // AES-256-GCM encrypted base32 secret
  totpEnabledAt  DateTime?
  totpLastStep   Int?      // last accepted 30-second step, so a code cannot be replayed
  recoveryCodes  String?   // JSON array of sha256 hashes, each usable once
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
}

model Patient {
  id             String          @id @default(cuid())
  clinicId       String
  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  userId         String?         @unique
  user           User?           @relation(fields: [userId], references: [id])
  name           String
  phone          String
  birthDate      DateTime
  bloodGroup     String?
  gravida        Int             @default(0)
  para           Int             @default(0)
  abortions      Int             @default(0)
  notes          String?
  cycleLengthAvg Int             @default(28)
  periodLengthAvg Int            @default(5)
  /// "HH:mm" local; drive the medicine timetable
  wakeTime       String          @default("07:00")
  sleepTime      String          @default("23:00")
  ramadanMode    Boolean         @default(false)
  /// Lock-screen text stays generic unless the patient opts in
  detailedNotifications Boolean  @default(false)
  prescriptions  Prescription[]
  doseEvents     DoseEvent[]
  dangerReports  DangerReport[]
  appointments   Appointment[]
  cycleLogs      CycleLog[]
  contraceptions Contraception[]
  pregnancies    Pregnancy[]
  readings       HomeReading[]
  messages       Message[]
  alerts         Alert[]
  createdAt      DateTime        @default(now())
}

enum ApptType {
  NEW_PATIENT
  FOLLOW_UP
  ANTENATAL
  ULTRASOUND
  CONTRACEPTION_REVIEW
  IUD_INSERTION
  IMPLANT_REMOVAL
  PAP_SMEAR
  POSTPARTUM
}

enum ApptStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id        String     @id @default(cuid())
  patientId String
  patient   Patient    @relation(fields: [patientId], references: [id])
  type      ApptType
  status    ApptStatus @default(SCHEDULED)
  startsAt  DateTime
  minutes   Int        @default(20)
  reason    String?
  notes     String?
  /// What to do before, in plain words ("تعالي صايمة من الساعة 10 بالليل")
  prep      String?
  place     String?
  /// null = not answered, true = coming, false = wants to reschedule
  confirmed Boolean?
  /// Clinic-recorded visit summary shown to the patient
  fetalHr   Int?
  weightKg  Float?
  scanNote  String?
  createdAt DateTime   @default(now())
}

enum Flow {
  SPOTTING
  LIGHT
  MEDIUM
  HEAVY
}

model CycleLog {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  date      DateTime
  bleeding  Boolean  @default(false)
  flow      Flow?
  pain      Int?
  mood      String?
  symptoms  String?
  note      String?
  createdAt DateTime @default(now())

  @@unique([patientId, date])
}

enum ContraMethod {
  COMBINED_PILL
  PROGESTIN_PILL
  PATCH
  RING
  INJECTION
  IMPLANT
  IUD_HORMONAL
  IUD_COPPER
  CONDOM
  FERTILITY_AWARENESS
  NONE
}

enum PackType {
  P21_7
  P24_4
  P28
  POP
}

model Contraception {
  id            String       @id @default(cuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id])
  method        ContraMethod
  brand         String?
  startedAt     DateTime
  expiresAt     DateTime?
  endedAt       DateTime?
  note          String?
  /// Pill mode
  packType      PackType?
  packStartedAt DateTime?
  pillTime      String?
  doseEvents    DoseEvent[]
  createdAt     DateTime     @default(now())
}

enum TimingRule {
  ANY
  MORNING
  BEDTIME
  WITH_FOOD
  EMPTY_STOMACH
  AWAY_FROM_IRON
}

enum Criticality {
  HIGH
  NORMAL
}

enum RxSource {
  PRESCRIBED
  SELF
}

/// One medicine per patient, created by the clinic. Patients never type a dose.
model Prescription {
  id          String      @id @default(cuid())
  clinicId    String
  clinic      Clinic      @relation(fields: [clinicId], references: [id])
  patientId   String
  patient     Patient     @relation(fields: [patientId], references: [id])
  /// Formulary key, e.g. IRON, FOLIC, CALCIUM, VITD, ASPIRIN, PROGESTERONE, LEVOTHYROXINE, OTHER
  drug        String
  /// Patient-facing name ("حبة الحديد")
  label       String
  strength    String?
  dose        String      @default("حبة وحدة")
  timesPerDay Int         @default(1)
  timing      TimingRule  @default(ANY)
  /// Fixed times "HH:mm" csv; when empty the timetable builder picks them
  times       String?
  startAt     DateTime?
  startWeek   Int?
  stopAt      DateTime?
  stopWeek    Int?
  indication  String?
  criticality Criticality @default(NORMAL)
  supplyCount Int?
  supplyAt    DateTime?
  source      RxSource    @default(PRESCRIBED)
  reviewedAt  DateTime?
  active      Boolean     @default(true)
  createdById String?
  doseEvents  DoseEvent[]
  createdAt   DateTime    @default(now())

  @@index([patientId])
}

enum DoseStatus {
  TAKEN
  LATE
  SKIPPED
  MISSED
}

model DoseEvent {
  id              String         @id @default(cuid())
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id])
  prescriptionId  String?
  prescription    Prescription?  @relation(fields: [prescriptionId], references: [id])
  contraceptionId String?
  contraception   Contraception? @relation(fields: [contraceptionId], references: [id])
  dueAt           DateTime
  status          DoseStatus
  reason          String?
  loggedAt        DateTime       @default(now())

  @@unique([prescriptionId, dueAt])
  @@unique([contraceptionId, dueAt])
  @@index([patientId, dueAt])
}

/// A tap on the red button or a danger sign picked in the daily check-in.
model DangerReport {
  id         String    @id @default(cuid())
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id])
  /// csv of sign keys
  signs      String
  /// CALL | ER | NONE
  action     String    @default("NONE")
  source     String    @default("button")
  handledAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([patientId, createdAt])
}

model Pregnancy {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id])
  lmp             DateTime?
  usDate          DateTime?
  usGaDays        Int?
  eddFinal        DateTime
  datingMethod    String
  rhNegative      Boolean   @default(false)
  active          Boolean   @default(true)
  outcome         String?
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())
}

enum ReadingKind {
  BP
  WEIGHT
  GLUCOSE
  KICKS
}

model HomeReading {
  id        String      @id @default(cuid())
  patientId String
  patient   Patient     @relation(fields: [patientId], references: [id])
  kind      ReadingKind
  takenAt   DateTime
  systolic  Int?
  diastolic Int?
  value     Float?
  note      String?
  createdAt DateTime    @default(now())
}

model Message {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  fromPatient Boolean
  body        String
  /// Staff name shown to the patient ("الممرضة هبة")
  authorName  String?
  /// true for the automatic receipt the app sends on every patient message
  auto        Boolean  @default(false)
  urgent      Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())
}

enum Severity {
  CRITICAL
  WARNING
  INFO
}

model Alert {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id])
  severity   Severity
  kind       String
  title      String
  detail     String
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([phone])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  meta      String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([target])
}
