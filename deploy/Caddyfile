# Automatic HTTPS for the own-server setup. DOMAIN comes from .env (e.g. api.ayadati.iq).
{$DOMAIN} {
	# Clients must not choose their own IP for the rate limits: drop these headers, Caddy sets X-Forwarded-For itself.
	reverse_proxy web:3000 {
		header_up -True-Client-IP
		header_up -CF-Connecting-IP
		header_up -X-Real-IP
	}
	encode gzip
}
