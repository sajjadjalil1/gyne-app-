# Copy to .env on your own server (docker-compose). Never commit the real .env.
DOMAIN=api.example.com
DB_PASSWORD=change-me-long-random
AUTH_SECRET=change-me-to-32-plus-random-characters
BOOTSTRAP_CLINIC_NAME=عيادتي
BOOTSTRAP_DOCTOR_NAME=د. سجاد جليل
BOOTSTRAP_DOCTOR_PHONE=07XXXXXXXXX
# Later, when an SMS/WhatsApp gateway is chosen:
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Browser origins allowed to call the API (not needed for the native app)
ALLOWED_ORIGINS=
