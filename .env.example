# PostgreSQL connection string (used by packages/db and apps/web)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gyne?schema=public"
# apps/web only
AUTH_SECRET="change-me-to-32-plus-random-characters"
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""
# development only: return the OTP in the API response
EXPOSE_DEV_OTP=0
# first run on an empty database: creates the clinic and the doctor's login
BOOTSTRAP_CLINIC_NAME="عيادتي"
BOOTSTRAP_DOCTOR_NAME=""
BOOTSTRAP_DOCTOR_PHONE=""
# pilot only: write login codes to the server log instead of sending them (remove once SMS_WEBHOOK_URL is set)
OTP_DELIVERY=""
